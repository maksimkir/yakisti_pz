<JSR223Assertion guiclass="TestBeanGUI" testclass="JSR223Assertion" testname="refund = 50% total (персональне правило)" enabled="true">
            <stringProp name="scriptLanguage">groovy</stringProp>
            <stringProp name="cacheKey">true</stringProp>
            <stringProp name="script">def json = new groovy.json.JsonSlurper().parseText(prev.getResponseDataAsString())
long total = Long.parseLong(vars.get("total"))
long expected = Math.floorDiv(total * 50L, 100L)
if (json.refund != expected) {
  AssertionResult.setFailure(true)
  AssertionResult.setFailureMessage("refund=" + json.refund + ", expected 50% of " + total + " = " + expected)
}</stringProp>
          </JSR223Assertion>
          <hashTree/>
</hashTree>
